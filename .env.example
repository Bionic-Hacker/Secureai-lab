# =============================================================================
# SecureAI Lab - environment template. Copy to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env. Per the build plan, .env.example is the only committed
# env file; real secrets come from a secrets manager at deploy time.
#
# Generate the three cryptographic values:
#   JWT_SECRET_KEY        openssl rand -hex 64
#   FIELD_ENCRYPTION_KEY  openssl rand -hex 32          <- raw hex, 64 chars
#   MFA_ENCRYPTION_KEY    a Fernet key (44 chars, ends in '=')
# The last two are DIFFERENT formats. config.py validates both and refuses to
# start if you swap them.
# =============================================================================

APP_ENV=development
APP_DEBUG=false
APP_NAME=SecureAI Lab
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=secureai
POSTGRES_PASSWORD=replace_with_a_strong_local_password
DATABASE_URL=postgresql+asyncpg://secureai:replace_with_a_strong_local_password@postgres:5432/secureai_lab

# --- Crypto ---
JWT_SECRET_KEY=replace_with_openssl_rand_hex_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FIELD_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
MFA_ENCRYPTION_KEY=replace_with_a_fernet_key
MFA_ISSUER_NAME=SecureAI Lab

# --- Lockout policy ---
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# --- Rate limiting (login limit must stay ABOVE the lockout threshold) ---
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
REDIS_URL=redis://redis:6379/0

# --- CORS / frontend ---
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Uploads / storage ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_STORAGE_PATH=/data/uploads
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- ClamAV ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- AI / vector store (unused until phase 3) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=http://local-llm:8080/v1
LOCAL_LLM_MODEL=llama-3.1-8b-instruct
CHROMA_HOST=vector-db
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=replace_with_a_random_token

# --- Audit ---
AUDIT_LOG_RETENTION_DAYS=365
