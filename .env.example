# =============================================================================
# SecureAI Lab — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env to source control.
# =============================================================================

# --- Application ---
APP_ENV=development                 # development | staging | production
APP_DEBUG=false                     # must be false in production
APP_NAME=SecureAI Lab
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
POSTGRES_USER=secureai_app
POSTGRES_PASSWORD=change_me_generate_a_long_random_value
POSTGRES_DB=secureai_lab
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://secureai_app:change_me_generate_a_long_random_value@db:5432/secureai_lab

# --- JWT Auth ---
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=replace_with_openssl_rand_hex_64_output
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password / Account Security ---
PASSWORD_HASH_SCHEME=argon2id
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# --- MFA (TOTP) ---
MFA_ISSUER_NAME=SecureAI Lab
# Fernet key for encrypting MFA secrets at rest: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=replace_with_fernet_key

# --- Field-level / file encryption (AES-256-GCM, data at rest) ---
# Raw 256-bit key, hex-encoded (NOT the Fernet-key format used above for
# MFA_ENCRYPTION_KEY — this one is consumed directly by AES-256-GCM, see
# backend/app/core/file_encryption.py):
#   openssl rand -hex 32
FIELD_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32_output

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
UPLOAD_RATE_LIMIT_PER_MINUTE=20
REDIS_URL=redis://redis:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- TLS (reverse proxy terminates TLS; see Docker/nginx) ---
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# --- AI Providers ---
AI_PROVIDER=local                   # openai | local  (Phase 4's chat model)
OPENAI_API_KEY=                     # only needed if EMBEDDING_PROVIDER=openai or AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b

# --- Embeddings (independent of AI_PROVIDER above) ---
# local  = sentence-transformers running in this container, no external
#          API call, no cost, no key needed — the default, and what this
#          project actually recommends (see phase-3-setup-walkthrough.txt)
# openai = OpenAI's embeddings API — requires a real OPENAI_API_KEY with
#          billing configured, or every ingestion attempt fails closed
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- RAG ingestion/retrieval ---
RAG_CHUNK_SIZE_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_RETRIEVAL_TOP_K=5

# --- AI Assistant (Phase 4) ---
ASSISTANT_MAX_HISTORY_MESSAGES=10
ASSISTANT_MAX_RESPONSE_TOKENS=800
ASSISTANT_USE_RAG_CONTEXT=true

# --- Code Review Engine (Phase 5) ---
# No settings needed yet — scan timeout and rules path are currently
# fixed constants in code_scan_service.py, not env-configurable.

# --- Vector DB (ChromaDB) ---
CHROMA_HOST=vector-db
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=replace_with_random_token

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_STORAGE_PATH=/data/uploads
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.py,.js,.ts,.java,.go,.rb,.php

# --- Storage backend ---
# local = write to the uploads_data Docker volume (default, no setup needed)
# s3    = any S3-compatible object store (AWS S3, Cloudflare R2, Backblaze B2,
#         DigitalOcean Spaces, MinIO) — required once you deploy off a host
#         with local persistent disk (Fly.io/Railway/Render volumes work too,
#         but S3-compatible storage decouples uploads from the compute host)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Malware Scanning (ClamAV) ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Monitoring ---
PROMETHEUS_METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# --- Audit / Logging ---
AUDIT_LOG_RETENTION_DAYS=365
LOG_LEVEL=INFO
